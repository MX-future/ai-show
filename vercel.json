{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/api" },
    { "source": "/images/(.*)", "destination": "/api/images" },
    { "source": "/sites/(.*)", "destination": "/api/sites" }
  ]
}
